@model lw_Confirmation_of_received_telegram.Models.M_View_MealPlanPage
@{
    ViewData["Title"] = "食事一覧";
    var dateStr = Model.TargetDate.ToString("yyyy-MM-dd");
}

@* 屋宜原版 Meal_Information トップ画面と同じ構成:
   日付 → 食事区分 → ←/本日/→ → 機能ボタン群（未実装は非活性） → 患者番号より履歴表示 *@
<form method="get" asp-controller="MealPlan" asp-action="Index" class="row g-2 align-items-center mb-2 mt-2">
    <div class="col-auto">
        <input type="date" name="date" value="@dateStr" class="form-control" />
    </div>
    <div class="col-auto">
        <select name="mealType" class="form-select">
            @foreach (var (val, label) in new[] { (1, "朝"), (2, "昼"), (3, "夕") })
            {
                if (val == Model.MealType)
                {
                    <option value="@val" selected>@label</option>
                }
                else
                {
                    <option value="@val">@label</option>
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">表示</button>
    </div>
    <div class="col-auto btn-group">
        <a class="btn btn-outline-secondary" asp-action="Index"
           asp-route-date="@Model.TargetDate.AddDays(-1).ToString("yyyy-MM-dd")" asp-route-mealType="@Model.MealType">&lt;</a>
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-mealType="@Model.MealType">今日</a>
        <a class="btn btn-outline-secondary" asp-action="Index"
           asp-route-date="@Model.TargetDate.AddDays(1).ToString("yyyy-MM-dd")" asp-route-mealType="@Model.MealType">&gt;</a>
    </div>
    @* 使えるボタン（今日/<>）と誤認しないよう、ボタン2つ分ほど間隔を空ける *@
    <div class="col-auto" style="margin-left: 12rem;">
        @* 将来実装する機能ボタン群（現在は非活性。グレー地＋白文字で「押せない」を明示） *@
        <button type="button" class="btn btn-secondary" disabled>フィルタ表示</button>
        <button type="button" class="btn btn-secondary" disabled>食札印刷</button>
        <button type="button" class="btn btn-secondary" disabled>帳票出力</button>
        <button type="button" class="btn btn-secondary" disabled>マスタ保守</button>
        <button type="button" class="btn btn-secondary" disabled>色設定</button>
    </div>
    @* 「患者番号より履歴表示」ボタンは非表示（行ごとの「履歴表示」ボタンに置き換えたため。2026-08-19） *@
</form>

<div class="alert alert-warning py-1 mb-2">
    ⚠ この一覧は<strong>仮データ</strong>です（meal_plan相当のテーブルが未実装のため、患者の顔ぶれは日付にかかわらず固定。
    患者名・食種名・コメント等の内容は実DBから取得しています）
</div>

@if (!Model.IsConnected)
{
    <div class="alert alert-danger">
        <strong>データ取得：失敗</strong>
        <p class="mb-0">@Model.ErrorMessage</p>
    </div>
}
else if (Model.Rows.Count == 0)
{
    <p>データがありません。</p>
}
else
{
    <div class="table-responsive border">
        <table class="table table-bordered table-striped table-sm align-middle mb-0">
            <thead>
                <tr>
                    <th>履歴</th>
                    <th>理由区分</th>
                    <th>変更</th>
                    <th class="col-code">病棟CD</th>
                    <th class="col-master-name">病棟名</th>
                    <th class="col-code">病室CD</th>
                    <th class="col-master-name">病室名</th>
                    <th>患者番号</th>
                    <th>患者名</th>
                    <th>カナ氏名</th>
                    <th>食事区分</th>
                    <th class="col-code">食種CD</th>
                    <th class="col-master-name">食種名</th>
                    <th class="col-code">主食CD</th>
                    <th class="col-master-name">主食名</th>
                    <th class="col-master-missing">コメント内容(マスタ未実装)</th>
                    <th class="col-master-name">禁止コメント内容</th>
                    <th>フリーコメント</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td>
                            @* WPF版の「行を選択→患者番号より履歴表示」に相当（この患者の番号を持って履歴画面へ） *@
                            <a class="btn btn-sm btn-outline-primary" asp-controller="OrderLog" asp-action="Index"
                               asp-route-patientNumber="@r.PatientNumber" asp-route-showInactive="true">履歴</a>
                        </td>
                        <td>@r.ReasonText</td>
                        <td>@r.ChangeMark</td>
                        <td>@r.WardCode</td>
                        <td>@r.WardName</td>
                        <td>@r.RoomCode</td>
                        <td>@r.RoomName</td>
                        <td>@r.PatientNumber</td>
                        <td>@r.KanjiName</td>
                        <td>@r.KanaName</td>
                        <td>@r.MealTimeText</td>
                        <td>@r.MealCode</td>
                        <td>@r.MealName</td>
                        <td>@r.MainDishCode</td>
                        <td>@r.MainDishName</td>
                        <td>@r.CommentText</td>
                        <td>@r.ContraText</td>
                        <td>@r.FreeComment</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small mt-1">@Model.TargetDate.ToString("yyyy/MM/dd") ・ @Model.Rows.Count 名</p>
}
