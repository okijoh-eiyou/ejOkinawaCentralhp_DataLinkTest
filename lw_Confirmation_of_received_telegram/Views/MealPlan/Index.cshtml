@model lw_Confirmation_of_received_telegram.Models.M_View_MealPlanJsonPage
@{
    ViewData["Title"] = "食事一覧";
    var dateStr = Model.TargetDate.ToString("yyyy-MM-dd");

    // 日付の隣に出す曜日。日曜=赤・土曜=青・平日=黒
    var weekday = "日月火水木金土"[(int)Model.TargetDate.DayOfWeek];
    var weekdayClass = Model.TargetDate.DayOfWeek switch
    {
        DayOfWeek.Sunday => "text-danger",
        DayOfWeek.Saturday => "text-primary",
        _ => "",
    };
}

@* 屋宜原版 Meal_Information トップ画面と同じ構成:
   日付 → 食事区分 → ←/本日/→ → 機能ボタン群（未実装は非活性） → 患者番号より履歴表示 *@
<form id="mealSearchForm" method="get" asp-controller="MealPlan" asp-action="Index" class="row g-2 align-items-center mb-2 mt-2">
    <div class="col-auto">
        @* 日付のすぐ後ろに曜日（2026/09/18(月) のように連続表示）、枠の右端にカレンダーボタン。
           日付入力に元々付いているカレンダーアイコンはCSSで隠し、右端のボタンから開く。日曜=赤・土曜=青 *@
        <div class="form-control date-with-weekday">
            <input type="date" id="mealDate" name="date" value="@dateStr" />
            <span class="fw-bold @weekdayClass">(@weekday)</span>
            <button type="button" class="date-picker-btn" onclick="openMealDatePicker()"
                    title="カレンダーを開く" aria-label="カレンダーを開く">
                @* カレンダーアイコン（Bootstrap Icons の calendar をインラインSVGで埋め込み。CDN不要） *@
                <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor"
                     viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z"/>
                </svg>
            </button>
        </div>
    </div>
    <div class="col-auto">
        <select name="mealType" class="form-select">
            @foreach (var (val, label) in new[] { (1, "朝"), (2, "昼"), (3, "夕") })
            {
                if (val == Model.MealType)
                {
                    <option value="@val" selected>@label</option>
                }
                else
                {
                    <option value="@val">@label</option>
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary btn-main-action">
            @* 虫眼鏡アイコン（Bootstrap Icons の search をインラインSVGで埋め込み。CDN不要） *@
            <svg xmlns="http://www.w3.org/2000/svg" width="1.1em" height="1.1em" fill="currentColor"
                 viewBox="0 0 16 16" style="vertical-align: -0.15em;" aria-hidden="true">
                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5C12 9.538 9.538 12 6.5 12S1 9.538 1 6.5 3.462 1 6.5 1 12 3.462 12 6.5z"/>
            </svg>
            検索
        </button>
    </div>
    @* 検索ボタンとは関連が薄いので少し距離を空ける（ms-4） *@
    <div class="col-auto btn-group ms-4">
        @* 前日/今日/翌日の移動でも、食事区分・コード非表示・フィルタの選択は引き継ぐ。
           フィルタは複数値（配列）のため asp-route ではなく Url.Action で組み立てる *@
        <a class="btn btn-outline-secondary"
           href="@Url.Action("Index", new { date = Model.TargetDate.AddDays(-1).ToString("yyyy-MM-dd"), mealType = Model.MealType, hideCodes = Model.HideCodes, wardCode = Model.WardCodes, mealCode = Model.MealCodes, mainDishCode = Model.MainDishCodes })">&lt;</a>
        <a class="btn btn-outline-secondary"
           href="@Url.Action("Index", new { mealType = Model.MealType, hideCodes = Model.HideCodes, wardCode = Model.WardCodes, mealCode = Model.MealCodes, mainDishCode = Model.MainDishCodes })">今日</a>
        <a class="btn btn-outline-secondary"
           href="@Url.Action("Index", new { date = Model.TargetDate.AddDays(1).ToString("yyyy-MM-dd"), mealType = Model.MealType, hideCodes = Model.HideCodes, wardCode = Model.WardCodes, mealCode = Model.MealCodes, mainDishCode = Model.MainDishCodes })">&gt;</a>
    </div>
    @* 機能ボタンは連結（btn-group）。「< 今日 >」とは関連が薄いので大きく距離を空ける（ms-5 = 3rem）。
       「帳票出力」はWeb版では不要になったため削除済み（2026-09-19 ミーティング。復活対象外） *@
    <div class="col-auto btn-group ms-5">
        @* フィルタは小ウィンドウ（モーダル）で開く。フィルタが効いている間は青塗りで明示 *@
        <button type="button" class="btn @(Model.FilterActive ? "btn-primary" : "btn-outline-primary")"
                data-bs-toggle="modal" data-bs-target="#filterModal">フィルタ表示</button>
        @* マスタ保守（lw_m_* 8マスタの追加・変更・削除）。別タブの子画面方式 *@
        <a class="btn btn-outline-primary" asp-controller="Master" asp-action="Index"
           target="_blank" rel="opener">マスタ保守</a>
    </div>
    @* 「患者番号より履歴表示」ボタンは非表示（行ごとの「履歴」ボタンに置き換えたため。2026-08-19） *@
    <div class="col-auto ms-auto">
        <div class="form-check">
            @* コード系（列名に「コード」を含む列）の表示切替。既定は非表示＝本番の見た目。
               マスタ解決できていない値の突き合わせをしたいときはチェックを外す。
               いずれ廃止予定のため右端（患者検索の隣）に寄せてある。
               hidden の false はチェックOFF時にも値を送るための定石 *@
            <input type="checkbox" id="hideCodes" name="hideCodes" value="true" class="form-check-input"
                   checked="@(Model.HideCodes ? "checked" : null)" />
            <input type="hidden" name="hideCodes" value="false" />
            <label class="form-check-label" for="hideCodes">コード系を非表示</label>
        </div>
    </div>
    <div class="col-auto">
        @* 患者検索は別タブで開く（WPFの子画面方式。閉じるとこの食事一覧タブに戻る）。
           rel="opener" は患者検索側の「閉じる」ボタン（window.close）を効かせるために必要 *@
        <a class="btn btn-success btn-main-action" asp-controller="OrderLog" asp-action="Index"
           target="_blank" rel="opener">
            @* 人型アイコン（Bootstrap Icons の person-fill をインラインSVGで埋め込み。CDN不要） *@
            <svg xmlns="http://www.w3.org/2000/svg" width="1.1em" height="1.1em" fill="currentColor"
                 viewBox="0 0 16 16" style="vertical-align: -0.15em;" aria-hidden="true">
                <path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1z"/>
                <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6"/>
            </svg>
            患者検索
        </a>
    </div>

</form>

@* フィルタは小ウィンドウ（Bootstrapモーダル）。選択肢は各マスタから。
   select は form 属性でメインのGETフォーム（mealSearchForm）に紐づくため、
   モーダルを閉じていても選択値は「検索」やナビの送信に乗る *@
<div class="modal fade" id="filterModal" tabindex="-1" aria-labelledby="filterModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 46rem;">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title fs-6" id="filterModalLabel">表示フィルタ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
            </div>
            <div class="modal-body">
                @* 病棟・食種・主食は横並びのチェックボックスリスト（2026-09-19 複数選択式に変更）。
                   同じリスト内の複数チェックは「どれかに一致（OR）」、リスト同士は掛け合わせ（AND）。
                   チェックなし＝そのリストは絞り込まない（旧「（すべて）」相当） *@
                <div class="row g-3">
                <div class="col-4">
                    <label class="form-label mb-1">病棟</label>
                    <div class="border rounded filter-check-list">
                        @foreach (var o in Model.WardOptions)
                        {
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" name="wardCode" value="@o.code"
                                       id="ward_@(o.code)" form="mealSearchForm"
                                       checked="@(Model.WardCodes.Contains(o.code) ? "checked" : null)" />
                                <label class="form-check-label" for="ward_@(o.code)">@(o.name != "" ? o.name : o.code)</label>
                            </div>
                        }
                    </div>
                </div>
                <div class="col-4">
                    <label class="form-label mb-1">食種</label>
                    <div class="border rounded filter-check-list">
                        @foreach (var o in Model.MealOptions)
                        {
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" name="mealCode" value="@o.code"
                                       id="meal_@(o.code)" form="mealSearchForm"
                                       checked="@(Model.MealCodes.Contains(o.code) ? "checked" : null)" />
                                <label class="form-check-label" for="meal_@(o.code)">@(o.name != "" ? o.name : o.code)</label>
                            </div>
                        }
                    </div>
                </div>
                <div class="col-4">
                    <label class="form-label mb-1">主食</label>
                    <div class="border rounded filter-check-list">
                        @foreach (var o in Model.MainDishOptions)
                        {
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" name="mainDishCode" value="@o.code"
                                       id="mainDish_@(o.code)" form="mealSearchForm"
                                       checked="@(Model.MainDishCodes.Contains(o.code) ? "checked" : null)" />
                                <label class="form-check-label" for="mainDish_@(o.code)">@(o.name != "" ? o.name : o.code)</label>
                            </div>
                        }
                    </div>
                </div>
                </div>
            </div>
            <div class="modal-footer py-2">
                @* フィルタ一括解除＝全チェックを外した状態で再表示（日付・食事区分・コード非表示は維持）。
                   me-auto で左端に寄せる（2026-09-19） *@
                <a class="btn btn-outline-secondary me-auto"
                   href="@Url.Action("Index", new { date = dateStr, mealType = Model.MealType, hideCodes = Model.HideCodes })">フィルタ一括解除</a>
                <button type="submit" class="btn btn-primary" form="mealSearchForm">絞り込み</button>
            </div>
        </div>
    </div>
</div>

@* ヒット件数はツールバーの真下に出す *@
@if (Model.IsConnected)
{
    <p class="text-muted small mb-2">@Model.TargetDate.ToString("yyyy/MM/dd") ・ @Model.Rows.Count 名</p>
}

@* 説明バナーは本番の見た目に近づけるため非表示（2026-09-18）
<div class="alert alert-info py-1 mb-2">
    この一覧は <strong>lw_meal_plan</strong> の <strong>disp_json</strong>（表示用データ）をそのまま表示しています
    （列＝JSONのキー・jsonbが返す順。disp_json が未生成の行は患者番号のみ表示）
</div>
*@

@if (!Model.IsConnected)
{
    <div class="alert alert-danger">
        <strong>データ取得：失敗</strong>
        <p class="mb-0">@Model.ErrorMessage</p>
    </div>
}
else if (Model.Rows.Count == 0)
{
    @* 補足文「この日付の食事計画が未生成の可能性…」は出さない（2026-09-19 ミーティング） *@
    <p>データがありません。</p>
}
else
{
    @* 「コード系を非表示」の対象: 列名に「コード」を含む列＋開始日・理由区分・開始時区分（2026-09-19 ミーティング）。
       理由区分_text は名前解決済みの表示用なので対象外（完全一致で判定する） *@
    bool IsCodeLike(string col) => col.Contains("コード") || col == "開始日" || col == "理由区分" || col == "開始時区分";

    @* 列の並び順（2026-09-19 ミーティング指定。先頭の履歴ボタン列は固定）。
       この指定に無い新キーが増えた場合は「指定列の後ろ・コード系の前」に出現順で出す。
       コード系（非表示対象）はコメント内容より右＝右端に寄せる *@
    var preferredOrder = new[]
    {
        "理由区分_text", "変更", "病室名", "病棟名", "ベッド名",
        "患者番号", "患者カナ氏名", "患者漢字氏名",
        "食種区分", "食種分類名称", "食種名", "主食名",
        "フリーコメント", "禁止コメント内容", "その他コメント内容", "経管情報コメント内容", "コメント内容",
    };
    var orderedColumns =
        preferredOrder.Where(c => Model.Columns.Contains(c))
        .Concat(Model.Columns.Where(c => !preferredOrder.Contains(c) && !IsCodeLike(c)))
        .Concat(Model.Columns.Where(c => IsCodeLike(c)))
        .ToList();

    var visibleColumns = Model.HideCodes
        ? orderedColumns.Where(c => !IsCodeLike(c)).ToList()
        : orderedColumns;

    @* コメント系（列名に「コメント」を含む）と食種名は全角10文字幅で折り返す *@
    string CellClass(string col) => col.Contains("コメント") || col == "食種名" ? "col-comment" : "";

    @* 画面に出す列名の読み替え（disp_jsonのキー → 表示ラベル。2026-09-19 ミーティング）。
       データの取り出しは元のキーのまま行い、見出しの文字だけ変える *@
    string HeaderLabel(string col) => col switch
    {
        "理由区分_text" => "理由区分",
        "患者カナ氏名" => "カナ名",
        "患者漢字氏名" => "患者名",
        _ => col.EndsWith("コメント内容") ? col[..^2] : col,   // 「〜コメント内容」→「〜コメント」
    };

    <div class="table-responsive border sticky-header-scroll">
        <table class="table table-bordered table-striped table-sm align-middle mb-0">
            <thead>
                <tr>
                    <th>履歴</th>
                    @* 列ラベルは disp_json のキーそのまま（jsonbが返す順。ただしコメント内容だけ一番右）。
                       「コード系を非表示」の対象列は、表示したときラベルを赤にする *@
                    @foreach (var col in visibleColumns)
                    {
                        <th class="@CellClass(col) @(IsCodeLike(col) ? "col-code" : "")">@HeaderLabel(col)</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td>
                            @* WPF版の「行を選択→患者番号より履歴表示」に相当（この患者の番号を持って別タブで開く）。
                               検索用には先頭ゼロ付きの原値を渡す *@
                            <a class="btn btn-sm btn-outline-success" asp-controller="OrderLog" asp-action="Index"
                               asp-route-patientNumber="@r.PatientNumber" asp-route-showInactive="true"
                               target="_blank" rel="opener">履歴</a>
                        </td>
                        @* コメント系の「,」区切り3色塗り分けは廃止して黒に戻した（2026-09-19 ミーティング） *@
                        @if (r.HasJson)
                        {
                            foreach (var col in visibleColumns)
                            {
                                <td class="@CellClass(col)">@(r.Values.GetValueOrDefault(col, ""))</td>
                            }
                        }
                        else
                        {
                            @* disp_json 未生成の行: 患者番号だけ出して残りは空欄 *@
                            foreach (var col in visibleColumns)
                            {
                                <td class="@CellClass(col)">@(col == "患者番号" ? r.DisplayPatientNumber : "")</td>
                            }
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<script>
    // 右端のカレンダーボタンから日付入力のネイティブピッカーを開く
    // （showPicker 非対応の古いブラウザでは入力欄へフォーカスするだけにする）
    function openMealDatePicker() {
        var input = document.getElementById('mealDate');
        try {
            input.showPicker();
        } catch (e) {
            input.focus();
        }
    }
</script>
