@model lw_Confirmation_of_received_telegram.Models.M_View_ReceiveMonitor
@{
    ViewData["Title"] = "受信モニタ";
}

<h1>受信モニタ</h1>

@if (!Model.IsConnected)
{
    <div class="alert alert-danger">
        <strong>DB接続：失敗</strong>
        <p class="mb-0">@Model.ErrorMessage</p>
        <p class="mb-0">appsettings.Development.json の接続文字列と、開発サーバーの稼働状態を確認してください。</p>
    </div>
}
else
{
    <table class="table table-bordered w-auto">
        <tbody>
            <tr>
                <th>受信電文の総件数</th>
                <td class="text-end">@Model.TotalCount 件</td>
            </tr>
            <tr>
                <th>本日の受信件数</th>
                <td class="text-end">@Model.TodayCount 件</td>
            </tr>
        </tbody>
    </table>

    <form method="get" asp-controller="OrderLog" asp-action="Index" class="row g-2 align-items-center mb-4">
        <div class="col-auto">
            <label class="col-form-label" for="patientNumber">患者番号</label>
        </div>
        <div class="col-auto">
            <input type="text" id="patientNumber" name="patientNumber" class="form-control" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">検索</button>
        </div>
    </form>

    <h2 class="h4">最新の受信電文（最大50件・新しい順）</h2>
    @if (Model.LatestLogs.Count == 0)
    {
        <p>データがありません。</p>
    }
    else
    {
        <partial name="_OrderLogTable" model="Model.LatestLogs" />
    }
}
