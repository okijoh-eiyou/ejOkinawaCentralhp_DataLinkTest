@* 最新の受信電文一覧（全患者・無効含む・最新300件）。検索バーの上に常時表示する。
   「詳細」を押すと、その患者番号で検索した状態＋その電文の展開表示に切り替わる *@
@model lw_Confirmation_of_received_telegram.Models.M_View_OrderSearch

<div class="table-responsive order-log-scroll order-log-scroll-sm border">
    <table class="table table-bordered table-striped table-sm align-middle mb-0">
        <thead>
            <tr>
                <th>詳細</th>
                <th>ID</th>
                <th>受信日時</th>
                <th>更新区分</th>
                <th>患者番号</th>
                <th>開始日</th>
                <th>開始食事区分</th>
                <th>理由区分</th>
                <th>処理済</th>
                <th>有効</th>
                <th>ファイル名</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var log in Model.LatestLogs)
            {
                @* この欄は純粋な2色ストライプ（無効のグレー塗りはしない。無効かは「有効」列で判別）。選択中のみ青 *@
                <tr class="@(log.id == Model.SelectedId ? "table-primary" : "")">
                    <td>
                        <a class="btn btn-sm btn-outline-primary" asp-controller="OrderLog" asp-action="Index"
                           asp-route-patientNumber="@log.patient_number"
                           asp-route-showInactive="true"
                           asp-route-selectedId="@log.id">詳細</a>
                    </td>
                    <td>@log.id</td>
                    <td>@log.created_at.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>@log.update_type</td>
                    <td>@log.patient_number</td>
                    <td>@log.start_date?.ToString("yyyy-MM-dd")</td>
                    <td>@(string.IsNullOrEmpty(log.start_meal_type_text) ? log.start_meal_type : log.start_meal_type_text)</td>
                    <td>@(string.IsNullOrEmpty(log.reason_type_text) ? log.reason_type : log.reason_type_text)</td>
                    <td>@(log.is_processed ? "済" : "未")</td>
                    <td>@(log.is_active ? "有効" : "無効")</td>
                    <td class="text-truncate" style="max-width: 12rem;" title="@log.file_name">@log.file_name</td>
                </tr>
            }
        </tbody>
    </table>
</div>
