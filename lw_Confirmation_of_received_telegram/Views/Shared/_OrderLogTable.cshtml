@* 電文一覧テーブル（画面1・画面2で共用）。無効データは灰色で表示する *@
@model List<lw_Confirmation_of_received_telegram.Models.M_order_log>

<div class="table-responsive">
    <table class="table table-striped table-sm align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>受信日時</th>
                <th>更新区分</th>
                <th>患者番号</th>
                <th>開始日</th>
                <th>開始食事区分</th>
                <th>理由区分</th>
                <th>処理済</th>
                <th>有効</th>
                <th>ファイル名</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var log in Model)
            {
                <tr class="@(log.is_active ? "" : "table-secondary")">
                    <td>@log.id</td>
                    <td>@log.created_at.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>@log.update_type</td>
                    <td>
                        <a asp-controller="OrderLog" asp-action="Index" asp-route-patientNumber="@log.patient_number">@log.patient_number</a>
                    </td>
                    <td>@log.start_date?.ToString("yyyy-MM-dd")</td>
                    <td>@(string.IsNullOrEmpty(log.start_meal_type_text) ? log.start_meal_type : log.start_meal_type_text)</td>
                    <td>@(string.IsNullOrEmpty(log.reason_type_text) ? log.reason_type : log.reason_type_text)</td>
                    <td>@(log.is_processed ? "済" : "未")</td>
                    <td>@(log.is_active ? "有効" : "無効")</td>
                    <td class="text-truncate" style="max-width: 12rem;" title="@log.file_name">@log.file_name</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" asp-controller="OrderLog" asp-action="Detail" asp-route-id="@log.id">詳細</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<p class="text-muted small mb-0">
    更新区分 A:追加 / D:削除 / I:一括削除。削除対象が無くても削除電文が届くのはI/F仕様どおりです。
</p>
