@using lw_Confirmation_of_received_telegram.Models
@model M_View_OrderDetail
@{
    ViewData["Title"] = "電文詳細";
}

<h1 class="h4 mt-2">電文詳細</h1>

@if (Model.IsConnected && Model.OrderLog != null)
{
    var log = Model.OrderLog;

    <table class="table table-bordered table-sm w-auto">
        <tbody>
            <tr><th>ID</th><td>@log.id</td></tr>
            <tr><th>受信日時</th><td>@log.created_at.ToString("yyyy-MM-dd HH:mm:ss")</td></tr>
            <tr><th>ファイル名</th><td>@log.file_name</td></tr>
            <tr><th>更新区分</th><td>@log.update_type（A:追加 / D:削除 / I:一括削除）</td></tr>
            <tr><th>患者番号</th><td>@log.patient_number</td></tr>
            <tr><th>開始日</th><td>@log.start_date?.ToString("yyyy-MM-dd")</td></tr>
            <tr><th>開始食事区分</th><td>@log.start_meal_type @log.start_meal_type_text</td></tr>
            <tr><th>理由区分</th><td>@log.reason_type @log.reason_type_text</td></tr>
            <tr>
                <th>状態</th>
                <td>
                    処理@(log.is_processed ? "済" : "未") /
                    @(log.is_active ? "有効" : "無効") /
                    追加@(log.is_appended ? "済" : "未")
                </td>
            </tr>
            <tr><th>更新日時</th><td>@log.updated_at.ToString("yyyy-MM-dd HH:mm:ss")</td></tr>
        </tbody>
    </table>
}

<partial name="_OrderDetailTables" model="Model" />

<a asp-controller="OrderLog" asp-action="Index" asp-route-patientNumber="@Model.OrderLog?.patient_number"
   asp-route-selectedId="@Model.OrderLog?.id" class="btn btn-outline-secondary mt-3">患者検索へ戻る</a>
