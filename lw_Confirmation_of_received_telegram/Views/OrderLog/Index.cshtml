@model lw_Confirmation_of_received_telegram.Models.M_View_OrderSearch
@{
    ViewData["Title"] = "患者検索";
}

@* 屋宜原版 MainWindow 上部と同じ構成: 患者番号 → 表示ボタン → 無効/削除データの表示。右端に検索件数 *@
<form method="get" asp-controller="OrderLog" asp-action="Index" class="row g-2 align-items-center mb-3 mt-2">
    <div class="col-auto">
        <input type="text" id="patientNumber" name="patientNumber" class="form-control"
               placeholder="患者番号" value="@Model.PatientNumber" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary px-4">表示</button>
    </div>
    <div class="col-auto">
        <div class="form-check">
            <input type="checkbox" id="showInactive" name="showInactive" value="true" class="form-check-input"
                   checked="@(Model.ShowInactive ? "checked" : null)" />
            <label class="form-check-label" for="showInactive">無効/削除データの表示</label>
        </div>
    </div>
    @if (Model.Searched && Model.IsConnected)
    {
        <div class="col-auto ms-auto">
            <span>検索件数: <strong>@Model.OrderLogs.Count</strong> 件</span>
        </div>
    }
</form>

@if (!Model.Searched)
{
    <p class="text-muted">患者番号を入力して「表示」を押してください。</p>
}
else if (!Model.IsConnected)
{
    <div class="alert alert-danger">
        <strong>DB接続：失敗</strong>
        <p class="mb-0">@Model.ErrorMessage</p>
        <p class="mb-0">appsettings.Development.json の接続文字列と、開発サーバーの稼働状態を確認してください。</p>
    </div>
}
else if (Model.OrderLogs.Count == 0)
{
    <p>データがありません。</p>
    @if (!Model.ShowInactive)
    {
        <p class="text-muted">「無効/削除データの表示」にチェックを入れると見つかる場合があります。</p>
    }
}
else
{
    <partial name="_OrderLogTable" model="Model" />

    @if (Model.Detail != null)
    {
        <partial name="_OrderDetailTables" model="Model.Detail" />
    }
    else
    {
        <p class="text-muted mt-3">一覧の「詳細」を押すと、その電文の展開データがここに表示されます。</p>
    }
}
