@model lw_Confirmation_of_received_telegram.Models.M_View_OrderSearch
@{
    ViewData["Title"] = "患者検索";
}

@* 最新の受信電文欄は連携テスト完了により非表示（2026-09-18）。
   復活させる場合は下のブロックのコメントを外し、OrderLogController.Index の
   LatestLogs 取得処理（同日にコメントアウト）も戻すこと。
<details open class="latest-log-panel mt-2">
    <summary class="h6 mb-1">最新の受信電文（全患者・最新300件）［クリックで開閉］</summary>
    @if (Model.LatestLogsError != "")
    {
        <div class="alert alert-danger py-1 mb-2">最新電文一覧を取得できませんでした: @Model.LatestLogsError</div>
    }
    else if (Model.LatestLogs.Count == 0)
    {
        <p class="text-muted small mb-2">受信電文はありません。</p>
    }
    else
    {
        <partial name="_LatestOrderLogTable" model="Model" />
    }
</details>
*@

@* 屋宜原版 MainWindow 上部と同じ構成: 患者番号 → 表示ボタン → 無効/削除データの表示。右端に検索件数 *@
<form method="get" asp-controller="OrderLog" asp-action="Index" class="row g-2 align-items-center mb-3 mt-3">
    <div class="col-auto">
        <input type="text" id="patientNumber" name="patientNumber" class="form-control"
               placeholder="患者番号" value="@Model.PatientNumber" />
    </div>
    <div class="col-auto">
        @* 配色は食事一覧の「患者検索」ボタンと同じ緑地・白文字 *@
        <button type="submit" class="btn btn-success px-4">検索</button>
    </div>
    <div class="col-auto">
        <div class="form-check">
            <input type="checkbox" id="showInactive" name="showInactive" value="true" class="form-check-input"
                   checked="@(Model.ShowInactive ? "checked" : null)" />
            <label class="form-check-label" for="showInactive">無効/削除データの表示</label>
        </div>
    </div>
    <div class="col-auto ms-auto">
        @* WPF版の右上「閉じる」に相当。別タブで開かれたこの画面を閉じる（＝食事一覧のタブに戻る）。
           直接URLで開かれていて閉じられない場合は食事一覧へ遷移する *@
        <button type="button" class="btn btn-outline-secondary fw-bold" onclick="closePatientSearch()">閉じる</button>
    </div>
    @if (Model.Searched && Model.IsConnected)
    {
        <div class="col-auto">
            <span>検索件数: <strong>@Model.OrderLogs.Count</strong> 件</span>
        </div>
    }
</form>

@if (!Model.Searched)
{
    <p class="text-muted">患者番号を入力して「検索」を押してください。</p>
}
else if (!Model.IsConnected)
{
    <div class="alert alert-danger">
        <strong>DB接続：失敗</strong>
        <p class="mb-0">@Model.ErrorMessage</p>
        <p class="mb-0">appsettings.Development.json の接続文字列と、開発サーバーの稼働状態を確認してください。</p>
    </div>
}
else if (Model.OrderLogs.Count == 0)
{
    <p>データがありません。</p>
    @if (!Model.ShowInactive)
    {
        <p class="text-muted">「無効/削除データの表示」にチェックを入れると見つかる場合があります。</p>
    }
}
else
{
    <partial name="_OrderLogTable" model="Model" />

    @if (Model.Detail != null)
    {
        <partial name="_OrderDetailTables" model="Model.Detail" />
    }
    @* 「詳細を押すと〜」の案内文は非表示（2026-09-18。本番の見た目に合わせる） *@
}

<script>
    // 「閉じる」: 別タブとして開かれていればタブごと閉じる（＝食事一覧のタブに戻る）。
    // 直接URLで開かれていて閉じられない場合（ブラウザが拒否）は食事一覧へ移動する
    function closePatientSearch() {
        window.close();
        setTimeout(function () { window.location.href = '@Url.Action("Index", "MealPlan")'; }, 200);
    }
</script>
